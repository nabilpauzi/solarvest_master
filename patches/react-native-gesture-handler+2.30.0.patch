+          // can render outside of the view bounds (overflow visible)
+          found = traverseWithPointerEvents(child, coords, pointerId, event)
+        }
+        coords[0] = restoreX
+        coords[1] = restoreY
+        if (found) {
+          return true
+        }
+      }
+    }
+    return false
+  }
