+        action == MotionEvent.ACTION_POINTER_UP ||
+        action == MotionEvent.ACTION_HOVER_EXIT
+      ) {
+        val pointerId = event.getPointerId(event.actionIndex)
+        handler.stopTrackingPointer(pointerId)
+      }
+    }
+
+    event.recycle()
+  }
